# syntax=docker/dockerfile:1

# Thin runtime image over an `out/` that was already built on the developer
# machine (`npm run build`). Used because the server has ~1GB of free RAM —
# too little to run `next build` safely alongside the other projects on it —
# and because it needs no registry pull beyond nginx:alpine, which the server
# already has locally.
#
# Build `out/` first, then:  docker build -f Dockerfile.prebuilt -t dorbrij-web .
# For a self-contained build that compiles the app itself, use ./Dockerfile.

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY out /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
